{
    "compilerOptions": {
      "module": "Node16",
      "target": "ES2020",
      "outDir": "dist",
      "lib": [
        "ES2020", "WebWorker", "DOM", "DOM.Iterable"
      ],
      "sourceMap": true,
      "rootDir": "src",
      "strict": true,
      "noImplicitReturns": false,
      "noFallthroughCasesInSwitch": false,
      "noUnusedParameters": false
    }
  }
  