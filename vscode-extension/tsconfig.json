{
    "compilerOptions": {
      "module": "Node16",
      "target": "ES2020",
      "outDir": "dist",
      "lib": [
        "ES2020", "DOM"
      ],
      "sourceMap": true,
      "rootDir": "src",
      "strict": true,
      "noImplicitReturns": false,
      "noFallthroughCasesInSwitch": false,
      "noUnusedParameters": false,
      "jsx": "react",
      "esModuleInterop": true,
      "skipLibCheck": true
    }
  }
  