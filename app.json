                                "description": "申请医师身份证号"
                            },
                            {
                                "name": "applyDate",    
                                "desc": "apply Date",
                                "type": "string",
                                "description": "申请日期"
                            },
                            {
                                "name": "applyType",
                                "desc": "apply Type",   
                                "type": "string",
                                "description": "申请类别"
                            }
                        ]
                    }
